<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar buttons: smoked slate with a snow hairline; focused they turn snow white with a warm amber rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/snow" />
            <stroke android:width="2dp" android:color="@color/amber" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59101826" />
            <stroke android:width="1dp" android:color="@color/hairline" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
