diff --git a/app/src/main/cpp/android_raop_callbacks.c b/app/src/main/cpp/android_raop_callbacks.c
index 1d3257f..3295e2b 100644
--- a/app/src/main/cpp/android_raop_callbacks.c
+++ b/app/src/main/cpp/android_raop_callbacks.c
@@ -3,6 +3,7 @@
  * All callbacks fire from RAOP's internal pthreads, so we AttachCurrentThread.
  */
 
+#include <pthread.h>
 #include <stdlib.h>
 #include <string.h>
 #include <time.h>
@@ -15,11 +16,28 @@
 #define LOGI(...) __android_log_print(ANDROID_LOG_INFO, TAG, __VA_ARGS__)
 #define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, TAG, __VA_ARGS__)
 
+/* A thread attached to the JVM must detach before it exits: Android 5's runtime aborts the whole
+   process ("Native thread exited without calling DetachCurrentThread") otherwise. Detach from a
+   pthread key destructor, which runs when the thread ends. */
+static pthread_key_t detach_key;
+static pthread_once_t detach_key_once = PTHREAD_ONCE_INIT;
+
+static void _detach_thread(void *jvm) {
+    if (jvm) (*(JavaVM *)jvm)->DetachCurrentThread((JavaVM *)jvm);
+}
+
+static void _make_detach_key(void) {
+    pthread_key_create(&detach_key, _detach_thread);
+}
+
 static JNIEnv *_get_env(android_callback_ctx_t *ctx) {
     JNIEnv *env = NULL;
     int status = (*ctx->jvm)->GetEnv(ctx->jvm, (void **)&env, JNI_VERSION_1_6);
     if (status == JNI_EDETACHED) {
-        (*ctx->jvm)->AttachCurrentThread(ctx->jvm, &env, NULL);
+        if ((*ctx->jvm)->AttachCurrentThread(ctx->jvm, &env, NULL) == JNI_OK) {
+            pthread_once(&detach_key_once, _make_detach_key);
+            pthread_setspecific(detach_key, ctx->jvm);
+        }
     }
     /* Clear any pending exception from a previous callback on this thread,
        otherwise JNI calls like NewByteArray will fatally abort. */
