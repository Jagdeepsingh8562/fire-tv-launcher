+import kotlinx.coroutines.delay
+
+// Plain Material 3 stand-ins for androidx.media3:media3-ui-compose-material3, which needs Android 6.0 (API 23).
+
+private class PlayerView(private val player: Player) {
+    var playing by mutableStateOf(player.isPlaying)
+    var positionMs by mutableLongStateOf(player.currentPosition)
+    var durationMs by mutableLongStateOf(player.duration.coerceAtLeast(0))
+    var metadata by mutableStateOf(player.mediaMetadata)
+
+    fun read() {
+        playing = player.isPlaying
+        positionMs = player.currentPosition
+        durationMs = player.duration.coerceAtLeast(0)
+        metadata = player.mediaMetadata
+    }
+}
+
+@Composable
+private fun rememberPlayerView(player: Player): PlayerView {
+    val view = remember(player) { PlayerView(player) }
+    DisposableEffect(player) {
+        val listener = object : Player.Listener {
+            override fun onEvents(player: Player, events: Player.Events) = view.read()
+        }
+        player.addListener(listener)
+        view.read()
+        onDispose { player.removeListener(listener) }
+    }
+    LaunchedEffect(player, view.playing) {
+        while (view.playing) {
+            delay(500)
+            view.read()
+        }
+    }
+    return view
+}
+
+private fun formatMs(ms: Long): String {
+    val total = ms / 1000
+    val s = total % 60
+    val m = (total / 60) % 60
+    val h = total / 3600
+    return if (h > 0) "%d:%02d:%02d".format(h, m, s) else "%d:%02d".format(m, s)
+}
+
+@Composable
+fun PlayPauseButton(playing: Boolean, onClick: () -> Unit, modifier: Modifier = Modifier, iconSize: Dp = 40.dp) {
+    IconButton(onClick = onClick, modifier = modifier) {
+        Icon(
+            imageVector = if (playing) Icons.Default.Pause else Icons.Default.PlayArrow,
+            contentDescription = if (playing) "Pause" else "Play",
+            modifier = Modifier.size(iconSize)
+        )
+    }
+}
+
+@Composable
+fun PlayPauseButton(player: Player, modifier: Modifier = Modifier, iconSize: Dp = 40.dp) {
+    val view = rememberPlayerView(player)
+    PlayPauseButton(
+        playing = view.playing,
+        onClick = { if (player.isPlaying) player.pause() else player.play() },
+        modifier = modifier,
+        iconSize = iconSize
+    )
+}
+
+@Composable
+fun PreviousButton(player: Player, modifier: Modifier = Modifier) {
+    IconButton(onClick = { player.seekToPrevious() }, modifier = modifier) {
+        Icon(Icons.Default.SkipPrevious, contentDescription = "Previous", modifier = Modifier.size(32.dp))
+    }
+}
+
+@Composable
+fun NextButton(player: Player, modifier: Modifier = Modifier) {
+    IconButton(onClick = { player.seekToNext() }, modifier = modifier) {
+        Icon(Icons.Default.SkipNext, contentDescription = "Next", modifier = Modifier.size(32.dp))
+    }
+}
+
+@Composable
+fun PositionText(player: Player, modifier: Modifier = Modifier) {
+    val view = rememberPlayerView(player)
+    Text(formatMs(view.positionMs), modifier = modifier, style = MaterialTheme.typography.labelMedium)
+}
+
+@Composable
+fun DurationText(player: Player, modifier: Modifier = Modifier) {
+    val view = rememberPlayerView(player)
+    Text(formatMs(view.durationMs), modifier = modifier, style = MaterialTheme.typography.labelMedium)
+}
+
+@Composable
+fun ProgressSlider(player: Player, modifier: Modifier = Modifier) {
+    val view = rememberPlayerView(player)
+    var dragging by remember { mutableStateOf<Float?>(null) }
+    val duration = view.durationMs.coerceAtLeast(1L).toFloat()
+    Slider(
+        value = dragging ?: (view.positionMs / duration).coerceIn(0f, 1f),
+        onValueChange = { dragging = it },
+        onValueChangeFinished = {
+            dragging?.let { player.seekTo((it * duration).toLong()) }
+            dragging = null
+        },
+        modifier = modifier
+    )
+}
+
+@Composable
+fun MiniController(player: Player, onClick: () -> Unit, modifier: Modifier = Modifier) {
+    val view = rememberPlayerView(player)
+    val meta: MediaMetadata = view.metadata
+    val art = remember(meta.artworkData) {
+        meta.artworkData?.let { BitmapFactory.decodeByteArray(it, 0, it.size)?.asImageBitmap() }
+    }
+    Surface(
+        modifier = modifier.fillMaxWidth().clickable(onClick = onClick),
+        shape = RoundedCornerShape(12.dp),
+        color = MaterialTheme.colorScheme.surfaceContainerHigh
+    ) {
+        Row(
+            modifier = Modifier.padding(8.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(12.dp)
+        ) {
+            if (art != null) {
+                Image(art, contentDescription = null, contentScale = ContentScale.Crop, modifier = Modifier.size(48.dp))
+            }
+            Column(modifier = Modifier.weight(1f)) {
+                Text(meta.title?.toString().orEmpty(), maxLines = 1, overflow = TextOverflow.Ellipsis,
+                    style = MaterialTheme.typography.titleSmall)
+                Text(meta.artist?.toString().orEmpty(), maxLines = 1, overflow = TextOverflow.Ellipsis,
+                    style = MaterialTheme.typography.bodySmall)
+            }
+            PlayPauseButton(player, iconSize = 28.dp)
+        }
+    }
+}
