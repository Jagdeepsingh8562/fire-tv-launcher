# Settings for phone-remote/server.py. Copy this file to .env (git ignores .env) and fill it in.
# Real environment variables override this file.

# The TV's address (Settings > My Fire TV > About > Network) and the port the phone page is served on.
TV_HOST=192.168.xx.xx
PORT=5400

# "Ask": a free key from https://aistudio.google.com/apikey . Without it the server falls back to the
# Claude Code CLI (a signed-in Claude plan); with neither, Ask says so and the rest of the remote still works.
GEMINI_API_KEY=
# Optional. Default is gemini-flash-latest (a Flash model; the free tier is Flash-only). Pin one if you like.
GEMINI_MODEL=
# Optional: "gemini" or "claude" to force one. Blank picks Gemini when GEMINI_API_KEY is set.
AI_PROVIDER=
